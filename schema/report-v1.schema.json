{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Device Lab report v1",
  "type": "object",
  "required": [
    "version",
    "createdAt",
    "items"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "label": {
      "type": "string"
    },
    "trust": {
      "type": "string"
    },
    "privacy": {
      "type": "object"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "status",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {},
          "source": {
            "type": "string"
          },
          "limit": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "at": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
