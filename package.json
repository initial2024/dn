{
  "name": "personal-device-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/embed-html.mjs",
    "bundle": "npm run build && node scripts/make-bundle.mjs",
    "test": "npm run bundle && node --test tests/*.test.mjs",
    "restore:source": "node scripts/restore-source.mjs",
    "dev": "npm run build && npx wrangler dev",
    "deploy": "npm test && npx wrangler deploy"
  }
}
